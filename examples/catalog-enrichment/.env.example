# Ozon Seller API
OZON_CLIENT_ID=
OZON_API_KEY=
# Базовый URL Ozon (менять не нужно для прода)
OZON_BASE_URL=https://api-seller.ozon.ru

# 1С-Битрикс БУС — входящий webhook (без конечного метода):
# https://portal.tld/rest/USER_ID/TOKEN
VITRINA_WEBHOOK_URL=
# ID инфоблока каталога
VITRINA_IBLOCK_ID=
# ID хранилища Disk-модуля (disk.storage.getlist)
VITRINA_STORAGE_ID=
